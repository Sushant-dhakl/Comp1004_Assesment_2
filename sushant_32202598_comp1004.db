-- DISPLAY FINAL 3NF TABLES
-- =========================================================

SELECT * FROM User;

SELECT * FROM Student;

SELECT * FROM Staff;

SELECT * FROM Category;

SELECT * FROM Product;

SELECT * FROM CustomerOrder;

SELECT * FROM OrderItem;

SELECT * FROM MembershipPlan;

SELECT * FROM GymMembership;

SELECT * FROM Payment;

-- VERIFY REQUIRED RECORD COUNTS
-- =========================================================

SELECT 'Users' AS TableName, COUNT(*) AS RecordCount
FROM User

UNION ALL

SELECT 'Categories', COUNT(*)
FROM Category

UNION ALL

SELECT 'Products', COUNT(*)
FROM Product

UNION ALL

SELECT 'Orders', COUNT(*)
FROM CustomerOrder

UNION ALL

SELECT 'Order Items', COUNT(*)
FROM OrderItem

UNION ALL

SELECT 'Payments', COUNT(*)
FROM Payment;


--Queries, views, indexes
--========================================
-- Sushant Dhakal, 32202598

SELECT
    UserID,
    UserFullName,
    UserType
FROM User
WHERE UserType = 'Student'
ORDER BY UserFullName;


SELECT
    co.OrderID,
    u.UserFullName,
    co.OrderDate,
    co.OrderStatus
FROM CustomerOrder AS co
INNER JOIN User AS u
    ON co.UserID = u.UserID
ORDER BY co.OrderID;


SELECT
    p.ProductName,
    SUM(oi.ItemQuantity) AS TotalQuantitySold,
    SUM(oi.ItemQuantity * oi.ItemUnitPrice) AS TotalSales
FROM OrderItem AS oi
INNER JOIN Product AS p
    ON oi.ProductID = p.ProductID
GROUP BY
    p.ProductID,
    p.ProductName
ORDER BY TotalSales DESC;

CREATE VIEW vw_OrderSummary AS
SELECT
    co.OrderID,
    u.UserFullName,
    co.OrderDate,
    co.OrderStatus,
    SUM(oi.ItemQuantity * oi.ItemUnitPrice) AS OrderTotal
FROM CustomerOrder AS co
INNER JOIN User AS u
    ON co.UserID = u.UserID
INNER JOIN OrderItem AS oi
    ON co.OrderID = oi.OrderID
GROUP BY
    co.OrderID,
    u.UserFullName,
    co.OrderDate,
    co.OrderStatus;

SELECT *
FROM vw_OrderSummary
ORDER BY OrderID;