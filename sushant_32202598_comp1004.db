-- STAGE 2: SECOND NORMAL FORM (2NF)
-- Partial dependencies are removed.
-- User information depends on UserID.
-- Order information depends on OrderID.
-- Product information depends on ProductName.
-- OrderItem contains the composite relationship.
-- Payment depends on PaymentID.
-- Gym membership depends on GymMembershipID.

-- USER TABLE
-- =========================================================

CREATE TABLE User_2NF (

    UserID                       INTEGER PRIMARY KEY,

    UserFullName                 TEXT NOT NULL,

    UserEmailAddress             TEXT NOT NULL,

    UserPhoneNumber              TEXT,

    UserType                     TEXT NOT NULL,

    StudentIdentificationNumber  TEXT,

    StaffIdentificationNumber    TEXT
);
-- CUSTOMER ORDER TABLE
-- =========================================================

CREATE TABLE CustomerOrder_2NF (

    OrderID       INTEGER PRIMARY KEY,

    OrderDate     TEXT NOT NULL,

    OrderStatus   TEXT NOT NULL,

    UserID        INTEGER NOT NULL,

    FOREIGN KEY (UserID)
        REFERENCES User_2NF(UserID)
);
-- PRODUCT TABLE
-- =========================================================

CREATE TABLE Product_2NF (

    ProductName       TEXT PRIMARY KEY,

    ProductCategory   TEXT NOT NULL,

    ProductUnitPrice  REAL NOT NULL
);
-- ORDER ITEM TABLE
-- =========================================================

CREATE TABLE OrderItem_2NF (

    OrderID          INTEGER,

    ProductName      TEXT,

    ProductQuantity  INTEGER NOT NULL,

    PRIMARY KEY (OrderID, ProductName),

    FOREIGN KEY (OrderID)
        REFERENCES CustomerOrder_2NF(OrderID),

    FOREIGN KEY (ProductName)
        REFERENCES Product_2NF(ProductName)
);
-- PAYMENT TABLE
-- =========================================================

CREATE TABLE Payment_2NF (

    PaymentID       INTEGER PRIMARY KEY,

    PaymentDate     TEXT NOT NULL,

    PaymentAmount   REAL NOT NULL,

    PaymentMethod   TEXT NOT NULL,

    PaymentStatus   TEXT NOT NULL,

    OrderID         INTEGER,

    FOREIGN KEY (OrderID)
        REFERENCES CustomerOrder_2NF(OrderID)
);
-- GYM MEMBERSHIP TABLE
-- =========================================================

CREATE TABLE GymMembership_2NF (

    GymMembershipID          INTEGER PRIMARY KEY,

    GymMembershipPlanName    TEXT NOT NULL,

    GymMembershipStartDate   TEXT NOT NULL,

    GymMembershipEndDate     TEXT NOT NULL,

    GymMembershipStatus      TEXT NOT NULL,

    UserID                   INTEGER NOT NULL,

    FOREIGN KEY (UserID)
        REFERENCES User_2NF(UserID)
);
