-- STAGE 3: THIRD NORMAL FORM (3NF)
-- =========================================================
--
-- Transitive dependencies are removed.
--
-- User -> UserType -> Student/Staff information
-- Product -> Category
-- GymMembership -> MembershipPlan
--
-- These dependencies are separated into their own tables.
-- =========================================================


-- USER
-- =========================================================

CREATE TABLE User (

    UserID              INTEGER PRIMARY KEY AUTOINCREMENT,

    UserFullName        TEXT NOT NULL,

    UserEmailAddress    TEXT NOT NULL UNIQUE,

    UserPhoneNumber     TEXT,

    UserType            TEXT NOT NULL
                        CHECK (UserType IN ('Student', 'Staff'))
);
-- STUDENT
-- =========================================================

CREATE TABLE Student (

    UserID                       INTEGER PRIMARY KEY,

    StudentIdentificationNumber  TEXT NOT NULL UNIQUE,

    FOREIGN KEY (UserID)
        REFERENCES User(UserID)
);
-- STAFF
-- =========================================================

CREATE TABLE Staff (

    UserID                     INTEGER PRIMARY KEY,

    StaffIdentificationNumber  TEXT NOT NULL UNIQUE,

    FOREIGN KEY (UserID)
        REFERENCES User(UserID)
);
-- CATEGORY
-- =========================================================

CREATE TABLE Category (

    CategoryID     INTEGER PRIMARY KEY AUTOINCREMENT,

    CategoryName   TEXT NOT NULL UNIQUE
);
-- PRODUCT
-- =========================================================

CREATE TABLE Product (

    ProductID             INTEGER PRIMARY KEY AUTOINCREMENT,

    ProductName           TEXT NOT NULL,

    ProductDescription    TEXT,

    ProductPrice          REAL NOT NULL
                          CHECK (ProductPrice >= 0),

    ProductStockQuantity  INTEGER NOT NULL DEFAULT 0
                          CHECK (ProductStockQuantity >= 0),

    CategoryID            INTEGER NOT NULL,

    FOREIGN KEY (CategoryID)
        REFERENCES Category(CategoryID)
);
-- CUSTOMER ORDER
-- =========================================================

CREATE TABLE CustomerOrder (

    OrderID       INTEGER PRIMARY KEY AUTOINCREMENT,

    OrderDate     TEXT NOT NULL DEFAULT CURRENT_DATE,

    OrderStatus   TEXT NOT NULL DEFAULT 'Pending'
                  CHECK (
                      OrderStatus IN
                      ('Pending',
                       'Confirmed',
                       'Processing',
                       'Completed',
                       'Cancelled')
                  ),

    UserID        INTEGER NOT NULL,

    FOREIGN KEY (UserID)
        REFERENCES User(UserID)
);
-- ORDER ITEM
-- =========================================================

CREATE TABLE OrderItem (

    OrderItemID    INTEGER PRIMARY KEY AUTOINCREMENT,

    OrderID        INTEGER NOT NULL,

    ProductID      INTEGER NOT NULL,

    ItemQuantity   INTEGER NOT NULL
                   CHECK (ItemQuantity > 0),

    ItemUnitPrice  REAL NOT NULL
                   CHECK (ItemUnitPrice >= 0),

    FOREIGN KEY (OrderID)
        REFERENCES CustomerOrder(OrderID),

    FOREIGN KEY (ProductID)
        REFERENCES Product(ProductID)
);


-- =========================================================
-- MEMBERSHIP PLAN
-- =========================================================

CREATE TABLE MembershipPlan (

    PlanID              INTEGER PRIMARY KEY AUTOINCREMENT,

    PlanName            TEXT NOT NULL UNIQUE,

    PlanDurationMonths  INTEGER NOT NULL
                        CHECK (PlanDurationMonths > 0),

    PlanPrice           REAL NOT NULL
                        CHECK (PlanPrice >= 0)
);

-- GYM MEMBERSHIP
-- =========================================================

CREATE TABLE GymMembership (

    MembershipID          INTEGER PRIMARY KEY AUTOINCREMENT,

    UserID                INTEGER NOT NULL,

    PlanID                INTEGER NOT NULL,

    MembershipStartDate   TEXT NOT NULL,

    MembershipEndDate     TEXT NOT NULL,

    MembershipStatus      TEXT NOT NULL DEFAULT 'Active'
                          CHECK (
                              MembershipStatus IN
                              ('Active',
                               'Expired',
                               'Cancelled')
                          ),

    FOREIGN KEY (UserID)
        REFERENCES User(UserID),

    FOREIGN KEY (PlanID)
        REFERENCES MembershipPlan(PlanID)
);



-- PAYMENT
-- =========================================================

CREATE TABLE Payment (

    PaymentID       INTEGER PRIMARY KEY AUTOINCREMENT,

    OrderID         INTEGER,

    MembershipID    INTEGER,

    PaymentDate     TEXT NOT NULL DEFAULT CURRENT_DATE,

    PaymentAmount   REAL NOT NULL
                    CHECK (PaymentAmount >= 0),

    PaymentMethod   TEXT NOT NULL
                    CHECK (
                        PaymentMethod IN
                        ('Credit Card',
                         'Debit Card',
                         'Cash',
                         'Bank Transfer')
                    ),

    PaymentStatus   TEXT NOT NULL DEFAULT 'Pending'
                    CHECK (
                        PaymentStatus IN
                        ('Pending',
                         'Successful',
                         'Failed',
                         'Refunded')
                    ),

    FOREIGN KEY (OrderID)
        REFERENCES CustomerOrder(OrderID),

    FOREIGN KEY (MembershipID)
        REFERENCES GymMembership(MembershipID),

    CHECK (
        (OrderID IS NOT NULL AND MembershipID IS NULL)
        OR
        (OrderID IS NULL AND MembershipID IS NOT NULL)
    )
);

