
-- UNNORMALIZED MASTER TABLE
--===============================

CREATE TABLE UnnormalizedMasterTable (

    UserID                       INTEGER,
    UserFullName                 TEXT,
    UserEmailAddress             TEXT,
    UserPhoneNumber              TEXT,
    UserType                     TEXT,
    StudentIdentificationNumber  TEXT,
    StaffIdentificationNumber    TEXT,

    OrderID                      INTEGER,
    OrderDate                    TEXT,
    OrderStatus                  TEXT,

    PurchasedProductName1        TEXT,
    PurchasedProductCategory1    TEXT,
    PurchasedProductUnitPrice1   REAL,
    PurchasedProductQuantity1    INTEGER,

    PurchasedProductName2        TEXT,
    PurchasedProductCategory2    TEXT,
    PurchasedProductUnitPrice2   REAL,
    PurchasedProductQuantity2    INTEGER,

    PurchasedProductName3        TEXT,
    PurchasedProductCategory3    TEXT,
    PurchasedProductUnitPrice3   REAL,
    PurchasedProductQuantity3    INTEGER,

    PaymentID                    INTEGER,
    PaymentDate                  TEXT,
    PaymentAmount                REAL,
    PaymentMethod                TEXT,
    PaymentStatus                TEXT,

    GymMembershipID              INTEGER,
    GymMembershipPlanName        TEXT,
    GymMembershipStartDate       TEXT,
    GymMembershipEndDate         TEXT,
    GymMembershipStatus          TEXT
);


