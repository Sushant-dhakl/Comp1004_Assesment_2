-- STAGE 1: FIRST NORMAL FORM (1NF)
-- Repeating product groups are removed.
-- There is now one row for each order-product combination.
-- Composite natural key:
-- (OrderID, ProductName)
-- =========================================================

CREATE TABLE OrderProductLine_1NF (

    UserID                       INTEGER,
    UserFullName                 TEXT,
    UserEmailAddress             TEXT,
    UserPhoneNumber              TEXT,
    UserType                     TEXT,
    StudentIdentificationNumber  TEXT,
    StaffIdentificationNumber    TEXT,

    OrderID                      INTEGER,
    OrderDate                    TEXT,
    OrderStatus                  TEXT,

    ProductName                  TEXT,
    ProductCategory              TEXT,
    ProductUnitPrice             REAL,
    ProductQuantity              INTEGER,

    PaymentID                    INTEGER,
    PaymentDate                  TEXT,
    PaymentAmount                REAL,
    PaymentMethod                TEXT,
    PaymentStatus                TEXT,

    GymMembershipID              INTEGER,
    GymMembershipPlanName        TEXT,
    GymMembershipStartDate       TEXT,
    GymMembershipEndDate         TEXT,
    GymMembershipStatus          TEXT
);
